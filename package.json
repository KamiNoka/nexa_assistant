{
	"name": "nexa-assistant",
	"version": "0.0.1",
	"description": "Nexa voice assistant",
	"author": "Nexa",
	"repository": {
		"type": "git",
		"url": "https://github.com/KamiNoka/nexa_assistant.git"
	},
	"main": "dist/main.js",
	"scripts": {
		"build": "npm --prefix vue run build",
		"start": "electron .",
		"start:mac": "ELECTRON_RUN_AS_NODE= electron .",
		"setup:voice": "node scripts/setup-voice.js",
		"install:linux": "bash scripts/install-linux.sh",
		"uninstall:linux": "bash scripts/uninstall-linux.sh",
		"dist": "electron-builder --win",
		"dist:linux": "electron-builder --linux",
		"dist:mac": "electron-builder --mac",
		"dist:publish": "electron-builder --win --publish always"
	},
	"build": {
		"appId": "com.nexa.app",
		"productName": "Nexa",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**/*",
			"renderer/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "resources",
				"to": "resources",
				"filter": [
					"**/*",
					"!whisper/.venv/**",
					"!whisper/.venv",
					"!whisper/build/**",
					"!**/__pycache__/**"
				]
			}
		],
		"publish": [
			{
				"provider": "github",
				"owner": "KamiNoka",
				"repo": "nexa_assistant",
				"releaseType": "release"
			}
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.ico",
			"artifactName": "${productName}-Setup-${version}.${ext}"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "build/icon.png",
			"category": "Utility",
			"maintainer": "KamiNoka",
			"synopsis": "Nexa voice assistant",
			"executableName": "nexa",
			"artifactName": "${productName}-${version}.${ext}",
			"desktop": {
				"Name": "Nexa",
				"GenericName": "Voice Assistant",
				"Comment": "Локальный голосовой AI-ассистент",
				"Categories": "Utility;",
				"Keywords": "nexa;voice;assistant;ассистент;голос;",
				"StartupWMClass": "Nexa"
			}
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"icon": "build/icon.png",
			"category": "public.app-category.productivity"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"allowElevation": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Nexa",
			"installerIcon": "build/icon.ico",
			"uninstallerIcon": "build/icon.ico",
			"license": "LICENSE.txt",
			"runAfterFinish": true
		},
		"compression": "maximum",
		"asar": true,
		"asarUnpack": [
			"resources/whisper/whisper_recognition.exe"
		],
		"npmRebuild": false
	},
	"dependencies": {
		"electron-updater": "^6.6.2",
		"smart-buffer": "^4.2.0",
		"telegram": "^2.26.22"
	},
	"devDependencies": {
		"electron": "^28.3.3",
		"electron-builder": "^24.9.1"
	}
}
